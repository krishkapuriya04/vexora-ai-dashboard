# =============================================================================
# VEXORA Environment Variables
# Copy to .env for local development. Set in Render dashboard for production.
# See DEPLOYMENT-PRODUCTION.md, RENDER_SETUP.md, ATLAS_SETUP.md
# =============================================================================

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB — local or Atlas (see ATLAS_SETUP.md)
MONGODB_URI=mongodb://127.0.0.1:27017/vexora

# Auth — REQUIRED in production (min 32 random characters)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Public URL of deployed app (Render sets RENDER_EXTERNAL_URL automatically)
# VEXORA_PUBLIC_URL=https://your-app.onrender.com

# CORS — comma-separated frontend origins (required for split frontend/backend)
# Use * only for local testing. Example:
# CORS_ORIGIN=https://krishkapuriya04.github.io,https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5000,http://localhost:3456,http://127.0.0.1:5000

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Set to true for local QA without live Razorpay API calls (npm run test:billing)
# RAZORPAY_MOCK=true

# Google Gemini AI — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Set to true for local QA without live Gemini API calls (npm run test:ai)
# GEMINI_MOCK=true

# -----------------------------------------------------------------------------
# Frontend (static deploy) — set in js/api-config.js, NOT in .env:
#   window.VEXORA_API_BASE = 'https://your-app.onrender.com';
# Or HTML meta: <meta name="vexora-api-base" content="https://...">
# -----------------------------------------------------------------------------
